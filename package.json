{
    "name": "chilly-menu",
    "type": "module",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w @chilly/web",
        "dev:cms": "npm run dev -w @chilly/cms",
        "build": "npm run build --workspaces --if-present",
        "preview": "npm run preview -w @chilly/web",
        "preview:cms": "npm run preview -w @chilly/cms",
        "db:migrate": "npm run db:migrate -w @chilly/web",
        "db:seed": "npm run db:seed -w @chilly/web",
        "test": "npm test --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0"
    },
    "lint-staged": {
        "*.{js,mjs,ts,vue}": "eslint --fix"
    }
}
