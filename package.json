{
    "name":  "leaf-menu",
    "type":  "module",
    "private":  true,
    "scripts":  {
                    "dev":  "nuxt dev",
                    "build":  "nuxt build",
                    "preview":  "nuxt build \u0026\u0026 wrangler dev",
                    "db:migrate":  "wrangler d1 migrations apply DB --local",
                    "db:seed":  "wrangler d1 execute DB --local --file seed.sql",
                    "test":  "node --experimental-sqlite --test \"test/*.test.mjs\"",
                    "postinstall":  "nuxt prepare",
                    "prepare":  "husky",
                    "lint":  "eslint ."
                },
    "dependencies":  {
                         "nuxt":  "^4.6.1",
                         "vue":  "^3.5.43",
                         "vue-router":  "^5.4.0"
                     },
    "devDependencies":  {
                            "@nuxt/eslint":  "^1.17.0",
                            "eslint":  "^10.12.0",
                            "husky":  "^9.1.7",
                            "lint-staged":  "^16.4.0",
                            "wrangler":  "^4.149.0"
                        },
    "lint-staged":  {
                        "*.{js,mjs,ts,vue}":  "eslint --fix"
                    }
}
