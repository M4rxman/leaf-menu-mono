{
    "name": "@chilly/web",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build",
        "preview": "nuxt build && wrangler dev --persist-to ../../.wrangler/state",
        "db:migrate": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
        "db:seed": "wrangler d1 execute DB --local --persist-to ../../.wrangler/state --file ../../packages/shared/seed.sql",
        "test": "node --experimental-strip-types --test \"test/*.test.mjs\"",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "typecheck": "nuxt typecheck"
    },
    "dependencies": {
        "@chilly/shared": "*",
        "@iconify-json/lucide": "^1.2.143",
        "@nuxt/icon": "^2.5.1",
        "@nuxt/ui": "^4.11.3",
        "@nuxtjs/i18n": "^10.6.0",
        "nitro-cloudflare-dev": "^0.2.2",
        "nuxt": "^4.6.1",
        "vue": "^3.5.43",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.17.0",
        "eslint": "^10.12.0",
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.13",
        "wrangler": "^4.149.0"
    }
}
