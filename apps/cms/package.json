{
    "name": "@chilly/cms",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "nuxt dev --port 3001",
        "build": "nuxt build",
        "preview": "nuxt build && wrangler dev --port 8788 --persist-to ../../.wrangler/state",
        "postinstall": "nuxt prepare",
        "test:worker": "nuxt build && vitest run",
        "test:worker:only": "vitest run",
        "lint": "eslint .",
        "typecheck": "nuxt typecheck && tsc --noEmit -p test/worker/tsconfig.json"
    },
    "dependencies": {
        "@chilly/shared": "*",
        "@iconify-json/lucide": "^1.2.143",
        "@nuxt/icon": "^2.5.1",
        "@nuxt/ui": "^4.11.3",
        "nitro-cloudflare-dev": "^0.2.2",
        "nuxt": "^4.6.1",
        "vue": "^3.5.43",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.4.3",
        "@cloudflare/workers-types": "^5.20261015.1",
        "@nuxt/eslint": "^1.17.0",
        "eslint": "^10.12.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.0",
        "vue-tsc": "^3.3.13",
        "wrangler": "^4.151.0"
    }
}
